# Endpoint que recebe os formulários (contato, Zoho, newsletter) via POST.
# Sugestão: Web-to-Lead do Zoho CRM ou um webhook do n8n.
# Sem essa variável, o formulário de contato abre o WhatsApp com a mensagem preenchida.
PUBLIC_LEAD_ENDPOINT=

# Chatbot de diagnóstico (Typebot). Com o ID preenchido, o bot substitui o formulário.
# PUBLIC_TYPEBOT_ID é o "public id" do bot publicado (ex.: tech-blues-diagnostico).
# PUBLIC_TYPEBOT_API_HOST só é necessário se o Typebot for self-hosted (ex.: https://bot.techblues.solutions).
PUBLIC_TYPEBOT_ID=
PUBLIC_TYPEBOT_API_HOST=
