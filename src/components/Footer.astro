---
import Icon from './Icon.astro';
import { site, whatsapp } from '../data/site';
import { solutions } from '../data/solutions';
import { segments } from '../data/segments';

const columns = [
  { title: 'Soluções', links: [...solutions.map((s) => ({ href: `/solucoes/${s.slug}`, label: s.title })), { href: '/zoho', label: 'Parceiro Zoho' }] },
  { title: 'Segmentos', links: segments.map((s) => ({ href: `/segmentos/${s.slug}`, label: s.title })) },
  {
    title: 'Informações',
    links: [
      { href: '/sobre', label: 'Sobre nós' },
      { href: '/projetos/sindiops', label: 'SindiOps' },
      { href: '/blog', label: 'Blog' },
      { href: '/contato', label: 'Contato' },
      { href: '/politica-de-privacidade', label: 'Política de privacidade' },
    ],
  },
];
---

<footer class="bg-marinho text-white">
  <div class="container-tb grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-[1.1fr_1.2fr_1.2fr_1fr_1.2fr] lg:gap-8">
    <div>
      <img src="/img/techblues-logo-horizontal-branca.svg" alt="Tech Blues" width="200" height="37" class="h-9 w-auto" loading="lazy" />
      <p class="mt-3 text-[11px] tracking-widest uppercase opacity-80">{site.tagline.replace('.', '')}</p>
    </div>
    {
      columns.map((col) => (
        <div>
          <h2 class="mb-3 text-[14px] font-bold uppercase">{col.title}</h2>
          <ul class="space-y-1.5 text-[13px]">
            {col.links.map((l) => (
              <li class="flex items-start gap-2">
                <span class="mt-[7px] size-1.5 shrink-0 bg-laranja" aria-hidden="true" />
                <a href={l.href} class="hover:underline">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    <div>
      <h2 class="mb-3 text-[14px] font-bold uppercase">Contato</h2>
      <ul class="space-y-2.5 text-[13px]">
        <li>
          <a href={whatsapp()} target="_blank" rel="noopener" class="flex items-center gap-2 hover:underline">
            <Icon name="Whatsapp" class="size-4" />
            {site.phone}
          </a>
        </li>
        <li>
          <a href={`mailto:${site.email}`} class="flex items-center gap-2 break-all hover:underline">
            <Icon name="Mail" class="size-4 shrink-0" />
            {site.email}
          </a>
        </li>
      </ul>
      <div class="mt-4 flex gap-3">
        <a href={site.social.linkedin} target="_blank" rel="noopener" class="hover:opacity-80">
          <Icon name="Linkedin" class="size-5" label="LinkedIn" />
        </a>
        <a href={site.social.instagram} target="_blank" rel="noopener" class="hover:opacity-80">
          <Icon name="Instagram" class="size-5" label="Instagram" />
        </a>
      </div>
    </div>
  </div>
  <p class="border-t border-white/10 py-5 text-center text-[12px] opacity-80">
    © {new Date().getFullYear()} {site.legalName}. Todos os direitos reservados.
  </p>
</footer>

<a
  href={whatsapp()}
  target="_blank"
  rel="noopener"
  class="fixed right-4 bottom-4 z-50 grid size-14 place-items-center rounded-full bg-[#25D366] text-white shadow-lg transition-transform hover:scale-105"
>
  <Icon name="Whatsapp" class="size-7" label="Conversar no WhatsApp" />
</a>
