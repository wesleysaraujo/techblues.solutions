---
const rawEndpoint = import.meta.env.PUBLIC_LEAD_ENDPOINT ?? '';
// Se não informado ou se apontar incorretamente para a raiz do Directus, usa o proxy /api/lead
const endpoint = !rawEndpoint || rawEndpoint === 'https://techblues.integratudo.com.br' ? '/api/lead' : rawEndpoint;
---

<section class="bg-cinza-ea">
  <div class="container-tb grid items-center gap-6 py-10 md:grid-cols-2 md:py-12">
    <h2 class="font-display text-[22px] font-black text-cinza-escuro uppercase md:text-[30px]">Receba conteúdos exclusivos.</h2>
    <div>
      <form id="newsletter" class="newsletter-form flex overflow-hidden rounded-md border-2 border-azul-claro bg-white" data-endpoint={endpoint}>
        <label for="nl-email" class="sr-only">Seu e-mail</label>
        <input id="nl-email" name="email" type="email" required placeholder="Seu e-mail" class="min-w-0 flex-1 px-3 py-2.5 text-[13px] focus:outline-none" />
        <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
        <button type="submit" class="nl-btn bg-azul px-4 text-[11px] font-extrabold text-white uppercase hover:bg-azul-profundo md:px-6 md:text-[12px] transition-colors disabled:opacity-60 disabled:cursor-not-allowed">Assinar newsletter</button>
      </form>
      <p class="nl-status mt-2 text-[12px]" role="status">
        Para se inscrever você precisa aceitar a nossa <a href="/politica-de-privacidade" class="underline hover:text-azul">Política de privacidade</a>.
      </p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('#newsletter, .newsletter-form').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      if (fd.get('website')) return; // honeypot

      const rawEmail = fd.get('email');
      const email = typeof rawEmail === 'string' ? rawEmail.trim().toLowerCase() : '';
      if (!email) return;

      const container = form.parentElement;
      const status = container?.querySelector<HTMLElement>('.nl-status') || form.querySelector<HTMLElement>('.nl-status');
      const btn = form.querySelector<HTMLButtonElement>('.nl-btn');
      const input = form.querySelector<HTMLInputElement>('input[name="email"]');
      const endpoint = form.dataset.endpoint;

      if (!endpoint) {
        location.href = `mailto:falecom@techblues.com.br?subject=${encodeURIComponent('Quero receber a newsletter')}&body=${encodeURIComponent(`E-mail: ${email}`)}`;
        return;
      }

      const originalBtnText = btn?.textContent || 'Assinar newsletter';
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Enviando…';
      }
      if (input) input.disabled = true;

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, origem: 'newsletter', pagina: location.pathname }),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        ((window as any).dataLayer ||= []).push({ event: 'newsletter_inscricao', pagina: location.pathname });
        if (status) {
          status.className = 'nl-status mt-2 text-[12px] font-semibold text-emerald-600';
          status.textContent = 'Inscrição confirmada. Obrigado!';
        }
        if (btn) {
          btn.textContent = 'Inscrito!';
        }
      } catch {
        if (status) {
          status.className = 'nl-status mt-2 text-[12px] font-medium text-red-600';
          status.textContent = 'Não foi possível inscrever agora. Tente novamente mais tarde.';
        }
        if (btn) {
          btn.disabled = false;
          btn.textContent = originalBtnText;
        }
        if (input) input.disabled = false;
      }
    });
  });
</script>
