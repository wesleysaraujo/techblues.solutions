---
import LeadForm from './LeadForm.astro';

interface Props {
  source: string;
  segment?: string;
  interestLabel?: string;
  interests?: string[];
  height?: number;
}
const { source, segment = '', interestLabel, interests, height = 560 } = Astro.props;
const typebot = import.meta.env.PUBLIC_TYPEBOT_ID ?? '';
const apiHost = import.meta.env.PUBLIC_TYPEBOT_API_HOST ?? '';
// Variáveis que o fluxo do Typebot recebe prontas (docs/typebot-diagnostico.md)
const vars = JSON.stringify({ origem: source, segmento: segment });
---

{
  typebot ? (
    <div
      class="diagnostico-bot overflow-hidden rounded-md bg-white shadow-xl"
      data-typebot={typebot}
      data-api-host={apiHost}
      data-vars={vars}
    >
      <typebot-standard style={`width: 100%; height: ${height}px;`} />
    </div>
  ) : (
    <LeadForm source={source} interestLabel={interestLabel} interests={interests} />
  )
}

<script is:inline type="module">
  const el = document.querySelector('.diagnostico-bot');
  if (el) {
    const init = async () => {
      const { default: Typebot } = await import('https://cdn.jsdelivr.net/npm/@typebot.io/js@0/dist/web.js');
      const vars = JSON.parse(el.dataset.vars);
      const q = new URLSearchParams(location.search);
      for (const k of ['utm_source', 'utm_medium', 'utm_campaign']) if (q.get(k)) vars[k] = q.get(k);
      vars.pagina = location.pathname;
      Typebot.initStandard({
        typebot: el.dataset.typebot,
        ...(el.dataset.apiHost ? { apiHost: el.dataset.apiHost } : {}),
        prefilledVariables: vars,
      });
    };
    // Carrega o bot só quando a seção se aproxima da tela
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) (io.disconnect(), init());
    }, { rootMargin: '600px' });
    io.observe(el);
  }
</script>
