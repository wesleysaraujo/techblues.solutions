---
import Icon from './Icon.astro';

interface Props {
  href: string;
  icon: string;
  title: string;
  text: string;
}
const { href, icon, title, text } = Astro.props;
---

<a href={href} class="card group flex gap-5 bg-gradient-to-b from-white to-cinza-claro p-6 transition-transform hover:-translate-y-1">
  <span class="grid size-14 shrink-0 place-items-center rounded-full bg-cinza-escuro text-white transition-colors group-hover:bg-azul">
    <Icon name={icon} class="size-6" />
  </span>
  <span class="border-l border-dotted border-cinza-medio pl-5">
    <span class="block text-[14px] font-bold text-cinza-escuro uppercase">{title}</span>
    <span class="mt-1.5 block text-[13px] leading-snug">{text}</span>
    <span class="mt-3 inline-flex items-center gap-1 text-[12px] font-bold text-azul uppercase">
      Saiba mais <Icon name="ArrowRight" class="size-3.5" />
    </span>
  </span>
</a>
