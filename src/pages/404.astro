---
import Base from '../layouts/Base.astro';
---

<Base title="Página não encontrada">
  <section class="bg-gradient-to-b from-azul to-azul-profundo py-24 text-center text-white">
    <div class="container-tb">
      <p class="font-display text-[80px] leading-none font-black">404</p>
      <h1 class="mt-4 font-display text-[26px] font-black uppercase">Esta página saiu do ar</h1>
      <p class="mt-3">O conteúdo pode ter mudado de endereço na nova versão do site.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn-laranja">Ir para a home</a>
        <a href="/blog" class="btn-branco">Ver o blog</a>
      </div>
    </div>
  </section>
</Base>
