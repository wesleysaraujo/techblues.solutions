---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import Icon from '../../components/Icon.astro';
import Carousel from '../../components/Carousel.astro';
import ProjectCover from '../../components/ProjectCover.astro';
import ContactSection from '../../components/ContactSection.astro';
import { projects } from '../../data/projects';
---

<Base
  title="Projetos em destaque"
  description="Projetos em destaque da Tech Blues: o EasySIM4U, e-commerce de conectividade para viajantes, e os produtos incubados pela casa — SindiOps e SuiteOps."
>
  <PageHero title="Projetos em destaque" crumbs={[{ href: '/', label: 'Home' }, { label: 'Projetos' }]} />

  <section class="py-16 md:py-24">
    <div class="container-tb">
      <SectionTitle eyebrow="Do papel para o mercado" title="Tecnologia que a gente constrói e coloca para rodar">
        <p class="mx-auto mt-4 max-w-2xl text-[15px]">
          Plataformas que construímos para clientes e produtos que a Tech Blues incuba por conta própria. Em todos, a
          mesma engenharia e a mesma I.A que entregamos para você.
        </p>
      </SectionTitle>

      <Carousel label="Projetos em destaque da Tech Blues" autoplay={6000}>
        {
          projects.map((p, i) => (
            <div data-slide class="w-full shrink-0 snap-start px-0.5 pb-2">
              <a
                href={`/projetos/${p.slug}`}
                class="card group grid h-full overflow-hidden transition-transform hover:-translate-y-1 lg:grid-cols-2"
              >
                <ProjectCover project={p} loading={i === 0 ? 'eager' : 'lazy'} class="h-full min-h-[260px] w-full" />
                <div class="p-6 md:p-10">
                  <div class="flex flex-wrap gap-2">
                    <span class="tag bg-laranja text-cinza-max">{p.kind}</span>
                    <span class="tag bg-azul text-white">{p.status}</span>
                  </div>
                  <div class="mt-4 flex items-center gap-3">
                    <img
                      src={p.logo}
                      alt=""
                      width="40"
                      height="40"
                      class:list={[p.logoWide ? 'h-10 w-auto max-w-[150px] object-contain' : 'size-10']}
                    />
                    <h2 class="font-display text-[30px] font-black text-cinza-escuro">{p.name}</h2>
                  </div>
                  <p class="mt-1 text-[13px] font-bold text-azul uppercase">{p.category}</p>
                  <p class="mt-4 text-[15px]">{p.summary}</p>
                  <ul class="mt-4 flex flex-wrap gap-2">
                    {p.audience.map((a) => (
                      <li class="tag bg-cinza-claro text-cinza-escuro">{a}</li>
                    ))}
                  </ul>
                  <span class="mt-6 inline-flex items-center gap-1 text-[13px] font-bold text-azul uppercase">
                    Ver o case completo <Icon name="ArrowRight" class="size-4" />
                  </span>
                </div>
              </a>
            </div>
          ))
        }
      </Carousel>

      <div class="mt-8 rounded-md border-2 border-dashed border-cinza-medio/40 p-8 text-center">
        <p class="font-display text-[20px] font-black text-cinza-escuro uppercase">Seu projeto pode ser o próximo destaque</p>
        <p class="mt-2 text-[15px]">Tem uma ideia de produto ou plataforma para o seu mercado? Desenvolvemos com você, do MVP à escala.</p>
        <a href="/solucoes/plataformas-saas" class="btn-contorno mt-5">Plataformas SaaS</a>
      </div>
    </div>
  </section>

  <ContactSection title="Tem uma ideia de produto? Vamos tirar do papel" source="projetos" />
</Base>
