---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import Icon from '../../components/Icon.astro';
import ProjectCover from '../../components/ProjectCover.astro';
import ContactSection from '../../components/ContactSection.astro';
import { projects } from '../../data/projects';
import { getSolution } from '../../data/solutions';

export const getStaticPaths = () => projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));

const { p } = Astro.props;
const services = p.services.map((s) => getSolution(s)!);
// Com print de tela, cada funcionalidade ganha uma faixa própria; sem print,
// viram cards numa grade.
const comImagem = p.features.every((f) => f.image);
---

<Base title={p.seoTitle} description={p.summary} image={p.cover}>
  <PageHero
    title={p.name}
    subtitle={p.kind}
    crumbs={[{ href: '/', label: 'Home' }, { href: '/projetos', label: 'Projetos' }, { label: p.name }]}
  />

  <!-- Apresentação -->
  <section class="py-16 md:py-24">
    <div class="container-tb grid items-center gap-10 lg:grid-cols-[1fr_1.1fr]">
      <div>
        <div class="flex flex-wrap gap-2">
          <span class="tag bg-laranja text-cinza-max">{p.category}</span>
          <span class="tag bg-azul text-white">{p.status}</span>
        </div>
        <h2 class="mt-4 font-display text-[24px] leading-tight font-black text-cinza-escuro md:text-[34px]">{p.headline}</h2>
        <p class="mt-5 text-[15px]">{p.summary}</p>
        <p class="mt-3 text-[15px]">{p.origin}</p>
        <p class="mt-5 text-[13px] font-bold text-cinza-escuro uppercase">Feito para</p>
        <ul class="mt-2 flex flex-wrap gap-2">
          {p.audience.map((a) => <li class="tag bg-cinza-claro text-cinza-escuro">{a}</li>)}
        </ul>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={p.url} target="_blank" rel="noopener" class="btn-laranja">
            {p.urlLabel} <Icon name="ExternalLink" class="size-4" />
          </a>
          <a href="#funcionalidades" class="btn-contorno">Ver funcionalidades</a>
        </div>
      </div>
      <ProjectCover project={p} loading="eager" class="aspect-[16/10] w-full rounded-md shadow-xl ring-1 ring-cinza-ea" />
    </div>
  </section>

  <!-- Ciclo do produto -->
  {
    p.flow && (
      <section class="bg-superficie py-16 md:py-24">
        <div class="container-tb">
          <SectionTitle eyebrow={p.flowEyebrow} title={p.flowTitle} />
          <ol class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
            {p.flow.map((etapa, i) => (
              <li class="card flex h-full flex-col p-6 ring-1 ring-cinza-ea">
                <div class="flex items-center justify-between gap-2">
                  <span class="grid size-10 place-items-center rounded-full bg-azul font-display text-[15px] font-black text-white">
                    {i + 1}
                  </span>
                  {etapa.done && (
                    <span class="tag bg-cinza-claro text-cinza-escuro">
                      <Icon name="Check" class="mr-1 size-3" /> No ar
                    </span>
                  )}
                </div>
                <h3 class="mt-4 text-[15px] font-bold text-cinza-escuro uppercase">{etapa.title}</h3>
                <p class="mt-1.5 text-[14px] leading-snug">{etapa.text}</p>
              </li>
            ))}
          </ol>
          {p.flowNote && <p class="mx-auto mt-10 max-w-2xl text-center text-[14px]">{p.flowNote}</p>}
        </div>
      </section>
    )
  }

  <!-- Funcionalidades -->
  <section
    id="funcionalidades"
    class:list={['scroll-mt-24 py-16 md:py-24', p.flow ? 'bg-white' : 'bg-superficie']}
  >
    <div class="container-tb">
      <SectionTitle eyebrow={p.featuresEyebrow} title={p.featuresTitle} />
      {
        comImagem ? (
          <div class="space-y-12 md:space-y-20">
            {p.features.map((f, i) => (
              <div class="grid items-center gap-8 lg:grid-cols-2">
                <div class:list={[i % 2 && 'lg:order-2']}>
                  <span class="grid size-12 place-items-center rounded-full bg-azul text-white">
                    <Icon name={f.icon} class="size-6" />
                  </span>
                  <h3 class="mt-4 font-display text-[22px] font-black text-cinza-escuro uppercase md:text-[28px]">
                    {f.title}
                  </h3>
                  <p class="mt-3 text-[15px]">{f.text}</p>
                </div>
                <img
                  src={f.image}
                  alt={`Tela do ${p.name}: ${f.title}`}
                  loading="lazy"
                  class="w-full rounded-md bg-white shadow-lg ring-1 ring-cinza-ea"
                />
              </div>
            ))}
          </div>
        ) : (
          <div class="grid gap-6 md:grid-cols-2">
            {p.features.map((f) => (
              <div class="card flex h-full flex-col p-6 ring-1 ring-cinza-ea md:p-8">
                <span class="grid size-12 place-items-center rounded-full bg-azul text-white">
                  <Icon name={f.icon} class="size-6" />
                </span>
                <h3 class="mt-4 font-display text-[20px] font-black text-cinza-escuro uppercase md:text-[24px]">
                  {f.title}
                </h3>
                <p class="mt-3 text-[15px]">{f.text}</p>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <!-- Princípios -->
  <section class="bg-marinho py-16 text-white md:py-24">
    <div class="container-tb">
      <SectionTitle eyebrow="Princípios do produto" title={p.principlesTitle} light />
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          p.principles.map((pr) => (
            <div class="rounded-md bg-white/10 p-6 ring-1 ring-white/15">
              <Icon name="ShieldCheck" class="size-7 text-laranja" />
              <h3 class="mt-3 text-[15px] font-bold uppercase">{pr.title}</h3>
              <p class="mt-1.5 text-[14px] opacity-90">{pr.text}</p>
            </div>
          ))
        }
      </div>
      {p.note && <p class="mx-auto mt-10 max-w-2xl text-center text-[13px] opacity-80">{p.note}</p>}
    </div>
  </section>

  <!-- O que a Tech Blues fez -->
  <section class="py-16 md:py-24">
    <div class="container-tb">
      <SectionTitle eyebrow="Bastidores" title={`O que a Tech Blues entrega no ${p.name}`}>
        <p class="mx-auto mt-4 max-w-2xl text-[15px]">
          As mesmas frentes que oferecemos aos nossos clientes estão por trás do produto. Se funciona para a nossa startup,
          funciona para o seu projeto.
        </p>
      </SectionTitle>
      <div class="grid gap-6 md:grid-cols-3">
        {
          services.map((s) => (
            <a href={`/solucoes/${s.slug}`} class="card group p-6 ring-1 ring-cinza-ea transition-transform hover:-translate-y-1">
              <span class="grid size-12 place-items-center rounded-full bg-cinza-escuro text-white group-hover:bg-azul">
                <Icon name={s.icon} class="size-5" />
              </span>
              <h3 class="mt-4 text-[15px] font-bold text-cinza-escuro uppercase">{s.title}</h3>
              <p class="mt-1.5 text-[14px] leading-snug">{s.short}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <ContactSection
    eyebrow={p.cta.eyebrow}
    title={p.cta.title}
    source={p.cta.source}
    segment={p.cta.segment}
    interestLabel="Interesse"
    interests={p.cta.interests}
  />
</Base>
