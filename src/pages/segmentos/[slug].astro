---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import Icon from '../../components/Icon.astro';
import StatsBar from '../../components/StatsBar.astro';
import ContactSection from '../../components/ContactSection.astro';
import SindiOpsHighlight from '../../components/SindiOpsHighlight.astro';
import { segments, type Segment } from '../../data/segments';
import { getSolution } from '../../data/solutions';
import { cta } from '../../data/site';

export function getStaticPaths() {
  return segments.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: Segment };
const others = segments.filter((o) => o.slug !== s.slug);
---

<Base title={`Tecnologia e I.A para ${s.title}`} description={`${s.headline} ${s.short}`}>
  <PageHero
    title={s.title}
    subtitle={s.headline}
    crumbs={[{ href: '/', label: 'Home' }, { href: '/segmentos', label: 'Segmentos' }, { label: s.title }]}
  />

  <!-- Dores -->
  <section class="py-16 md:py-24">
    <div class="container-tb grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="eyebrow mb-1.5">Estamos com você</p>
        <h2 class="h2">A rotina que a gente conhece</h2>
        <p class="mt-5 text-[15px]">{s.intro}</p>
        <a href={cta.href} class="btn-azul mt-8">{cta.label}</a>
      </div>
      <div class="rounded-md bg-cinza-claro p-6 md:p-8">
        <p class="text-[13px] font-bold text-cinza-escuro uppercase">Isso soa familiar?</p>
        <ul class="mt-4 space-y-3">
          {
            s.pains.map((p) => (
              <li class="flex items-start gap-3 text-[15px] text-cinza-max">
                <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-laranja text-cinza-max">
                  <Icon name="X" class="size-3" />
                </span>
                {p}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Soluções -->
  <section class="bg-azul py-16 text-white md:py-24">
    <div class="container-tb">
      <SectionTitle eyebrow="O caminho" title={`Como a Tech Blues ajuda ${s.audience.toLowerCase()}`} light />
      <div class="grid gap-6 md:grid-cols-2">
        {
          s.solutions.map((x) => {
            const sol = getSolution(x.solution)!;
            return (
              <div class="card flex gap-5 p-6 text-cinza-escuro">
                <span class="grid size-12 shrink-0 place-items-center rounded-full bg-cinza-escuro text-white">
                  <Icon name={sol.icon} class="size-5" />
                </span>
                <div class="border-l border-dotted border-cinza-medio pl-5">
                  <h3 class="text-[15px] font-bold uppercase">{x.title}</h3>
                  <p class="mt-1.5 text-[14px] leading-snug">{x.text}</p>
                  <a href={`/solucoes/${sol.slug}`} class="mt-3 inline-flex items-center gap-1 text-[12px] font-bold text-azul uppercase hover:underline">
                    {sol.title} <Icon name="ArrowRight" class="size-3.5" />
                  </a>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  {s.highlight?.project === 'sindiops' && <SindiOpsHighlight />}

  <!-- Zoho -->
  <section class="bg-cinza-claro py-16">
    <div class="container-tb grid items-center gap-8 md:grid-cols-[1fr_auto]">
      <div>
        <p class="eyebrow mb-1.5">Parceiro Zoho</p>
        <h2 class="font-display text-[20px] leading-tight font-black text-cinza-escuro uppercase md:text-[28px]">
          Ferramentas Zoho recomendadas para {s.audience.toLowerCase()}
        </h2>
        <ul class="mt-5 flex flex-wrap gap-2">
          {s.zoho.map((z) => <li class="rounded-md bg-white px-3 py-2 text-[13px] font-semibold text-cinza-max ring-1 ring-cinza-ea">{z}</li>)}
        </ul>
      </div>
      <a href="/zoho" class="btn-contorno">Ver catálogo Zoho</a>
    </div>
  </section>

  <StatsBar />

  <section class="py-14">
    <div class="container-tb">
      <p class="eyebrow mb-6 text-center">Outros segmentos</p>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          others.map((o) => (
            <a href={`/segmentos/${o.slug}`} class="flex items-center gap-3 rounded-md bg-cinza-claro p-4 text-[13px] font-bold text-cinza-escuro uppercase hover:text-azul">
              <Icon name={o.icon} class="size-5 shrink-0 text-azul" /> {o.title}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <ContactSection
    title={`Vamos conversar sobre a operação do seu ${s.slug === 'sindicos-profissionais' ? 'condomínio' : 'negócio'}`}
    source={`segmento-${s.slug}`}
    segment={s.title}
  />
</Base>
