      "webhookId": "45ac660a-ea49-409e-abf9-b2b5fcd9fa9f",
      "parameters": {
        "httpMethod": "POST",
        "path": "techblues-lead",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "https://www.techblues.com.br,https://techblues.com.br,http://localhost:4321"
